---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
---

<Layout title="About - Tailspin Toys">
  <div class="relative min-h-screen">
    <!-- Background decorative elements -->
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-blue-900/20 to-purple-900/30"></div>
    <div class="absolute top-20 left-10 w-72 h-72 bg-blue-500/10 rounded-full mix-blend-multiply filter blur-xl animate-blob"></div>
    <div class="absolute bottom-20 right-10 w-72 h-72 bg-purple-500/10 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-2000"></div>
    
    <div class="relative z-10 max-w-6xl mx-auto px-4 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-blue-500/10 border border-blue-400/20 rounded-full text-blue-300 text-sm font-medium backdrop-blur-sm">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"/>
          </svg>
          Our Story
        </div>
        
        <h1 class="text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-slate-100 via-blue-100 to-purple-100 bg-clip-text text-transparent">
          About Tailspin Toys
        </h1>
        
        <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
          Where DevOps methodology meets tabletop strategy gaming
        </p>
      </div>

      <!-- Main content card -->
      <div class="bg-gradient-to-br from-slate-800/60 via-slate-800/40 to-slate-900/60 backdrop-blur-sm border border-slate-700 rounded-2xl shadow-2xl p-8 md:p-12 mb-12">
        <!-- Mission statement -->
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-blue-400 mb-6 flex items-center">
            <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            Our Mission
          </h2>
          <p class="text-lg text-slate-300 leading-relaxed mb-6">
            Tailspin Toys is the premier crowdfunding platform dedicated to bringing board games with a development and DevOps twist to life. We believe that the same collaborative spirit, iteration cycles, and problem-solving that power modern software teams can make for endlessly engaging tabletop experiences.
          </p>
        </div>

        <!-- Features grid -->
        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="bg-gradient-to-br from-blue-500/10 to-blue-600/5 p-6 rounded-xl border border-blue-500/20">
            <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-slate-100 mb-3">Community Driven</h3>
            <p class="text-slate-400">
              By focusing exclusively on games that explore themes like continuous integration, agile planning, and incident response, we offer a unique space for developers and curious newcomers alike.
            </p>
          </div>

          <div class="bg-gradient-to-br from-purple-500/10 to-purple-600/5 p-6 rounded-xl border border-purple-500/20">
            <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-slate-100 mb-3">Innovation Focus</h3>
            <p class="text-slate-400">
              Our platform empowers creators at every stage of the design journey, from early-concept sketches through final prototype testing with community feedback and beta-play sessions.
            </p>
          </div>
        </div>

        <!-- Company story -->
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-purple-400 mb-6 flex items-center">
            <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            Our Story
          </h2>
          <p class="text-lg text-slate-300 leading-relaxed mb-6">
            The name "Tailspin Toys" reflects our love of both flight metaphors and that moment when a project takes on a life of its own - spinning through sprints, releases, and hotfixes until it soars. Founded by a team of developers who were always gamers at heart, we know firsthand how satisfying it is to conquer a tricky bug or pull off a flawless deployment.
          </p>
          <p class="text-lg text-slate-300 leading-relaxed">
            Whether you're here to back your next favorite game or to launch your own DevOps-inspired design, welcome aboard. Let's game from here, together!
          </p>
        </div>

        <!-- Stats section -->
        <div class="border-t border-slate-700 pt-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div class="group">
              <div class="text-3xl font-bold text-blue-400 mb-2 group-hover:scale-110 transition-transform duration-300">
                15+
              </div>
              <div class="text-slate-400 text-sm">Games Funded</div>
            </div>
            <div class="group">
              <div class="text-3xl font-bold text-purple-400 mb-2 group-hover:scale-110 transition-transform duration-300">
                500+
              </div>
              <div class="text-slate-400 text-sm">Creators</div>
            </div>
            <div class="group">
              <div class="text-3xl font-bold text-cyan-400 mb-2 group-hover:scale-110 transition-transform duration-300">
                10K+
              </div>
              <div class="text-slate-400 text-sm">Community Members</div>
            </div>
            <div class="group">
              <div class="text-3xl font-bold text-green-400 mb-2 group-hover:scale-110 transition-transform duration-300">
                2019
              </div>
              <div class="text-slate-400 text-sm">Founded</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Call to action -->
      <div class="text-center">
        <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 backdrop-blur-sm border border-blue-400/20 rounded-2xl p-8 mb-8">
          <h3 class="text-2xl font-bold text-slate-100 mb-4">Ready to Join Our Community?</h3>
          <p class="text-slate-300 mb-6 max-w-2xl mx-auto">
            Discover games that combine the strategic thinking of DevOps with the fun of tabletop gaming.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/" class="group px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold rounded-xl shadow-lg hover:shadow-blue-500/25 transform hover:scale-105 transition-all duration-300 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
              </svg>
              Explore Games
            </a>
            <button class="px-8 py-4 border-2 border-slate-600 hover:border-blue-400 text-slate-300 hover:text-blue-400 font-semibold rounded-xl backdrop-blur-sm hover:backdrop-blur-md transition-all duration-300 flex items-center justify-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Contact Us
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  
  .animate-blob {
    animation: blob 7s infinite;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
</style>