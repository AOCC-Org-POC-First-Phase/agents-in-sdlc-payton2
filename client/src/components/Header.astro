---
// Import any necessary dependencies
---

<header class="sticky top-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-700/50 transition-all duration-300">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center h-16">
      <!-- Logo and navigation -->
      <div class="flex items-center space-x-8">
        <!-- Mobile menu button -->
        <div class="relative group lg:hidden">
          <button id="menu-toggle" class="p-2 rounded-xl bg-slate-800/50 hover:bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          
          <!-- Mobile dropdown menu -->
          <nav id="menu" class="hidden absolute left-0 mt-2 w-64 bg-slate-800/95 backdrop-blur-md text-slate-200 rounded-2xl shadow-2xl border border-slate-700/50 z-10 transition-all duration-300">
            <div class="p-2">
              <div class="space-y-1">
                <a href="/" class="flex items-center px-4 py-3 rounded-xl hover:bg-slate-700/50 hover:text-blue-300 transition-all duration-300">
                  <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                  </svg>
                  Home
                </a>
                <a href="/about" class="flex items-center px-4 py-3 rounded-xl hover:bg-slate-700/50 hover:text-blue-300 transition-all duration-300">
                  <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  About
                </a>
                <div class="border-t border-slate-700/50 my-2"></div>
                <a href="#" class="flex items-center px-4 py-3 rounded-xl hover:bg-slate-700/50 hover:text-green-300 transition-all duration-300">
                  <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                  </svg>
                  Submit Game
                </a>
              </div>
            </div>
          </nav>
        </div>
        
        <!-- Logo -->
        <div class="flex items-center">
          <a href="/" class="group flex items-center space-x-3 hover:opacity-80 transition-opacity duration-300">
            <!-- Logo icon -->
            <div class="relative">
              <div class="w-10 h-10 bg-gradient-to-br from-blue-500 via-purple-500 to-cyan-500 rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-blue-500/25 transition-all duration-300">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="absolute -top-1 -right-1 w-4 h-4 bg-green-400 rounded-full border-2 border-slate-900 animate-pulse"></div>
            </div>
            
            <!-- Logo text -->
            <div>
              <h1 class="text-xl font-bold bg-gradient-to-r from-slate-100 to-slate-300 bg-clip-text text-transparent">
                Tailspin Toys
              </h1>
              <div class="text-xs text-slate-400 font-medium">DevOps Gaming</div>
            </div>
          </a>
        </div>
        
        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center space-x-1">
          <a href="/" class="px-4 py-2 rounded-xl text-slate-300 hover:text-blue-300 hover:bg-blue-500/10 transition-all duration-300 flex items-center space-x-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span>Home</span>
          </a>
          <a href="/about" class="px-4 py-2 rounded-xl text-slate-300 hover:text-blue-300 hover:bg-blue-500/10 transition-all duration-300 flex items-center space-x-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>About</span>
          </a>
        </nav>
      </div>
      
      <!-- Right side actions -->
      <div class="flex items-center space-x-4">
        <!-- Search -->
        <div class="hidden md:flex relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <input 
            type="text" 
            placeholder="Search games..." 
            class="w-64 pl-10 pr-4 py-2 bg-slate-800/50 border border-slate-600/50 rounded-xl text-slate-300 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500/50 backdrop-blur-sm transition-all duration-300"
          >
        </div>
        
        <!-- CTA Button -->
        <button class="hidden sm:flex items-center space-x-2 px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold rounded-xl shadow-lg hover:shadow-blue-500/25 transform hover:scale-105 transition-all duration-300">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          <span>Submit Game</span>
        </button>
        
        <!-- Mobile search icon -->
        <button class="md:hidden p-2 rounded-xl bg-slate-800/50 hover:bg-slate-700/50 text-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all duration-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Toggle menu visibility when hamburger is clicked
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const isClickInside = menuToggle.contains(event.target as Node) || menu.contains(event.target as Node);
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
      }
    });
    
    // Add smooth animation classes
    menu.classList.add('transition-all', 'duration-300', 'ease-in-out');
  }
</script>